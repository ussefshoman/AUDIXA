# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public Cloudflare R2 domain that serves PORTFOLIO SAMPLES only (public bucket / custom domain).
# Client scripts and master audio live in a separate PRIVATE bucket (added in M2/M4).
NEXT_PUBLIC_R2_PUBLIC_URL=

# Public Supabase Storage bucket 'branding' base URL is derived from NEXT_PUBLIC_SUPABASE_URL.

# ── M2/M3 (server-only secrets: never prefix with NEXT_PUBLIC_) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 private bucket for client scripts (and, later, master audio)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=

# Stripe (international cards + Apple Pay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paymob (Egypt). One integration ID per payment method enabled in your Paymob account, comma-separated.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=

# ── M4/M5 ──
R2_PUBLIC_BUCKET=            # bucket behind NEXT_PUBLIC_R2_PUBLIC_URL (portfolio samples only)

# ── M6: email, spam protection ──
RESEND_API_KEY=
EMAIL_FROM="Voice Studio <orders@yourdomain.com>"   # must be on a domain verified in Resend
ADMIN_EMAIL=                                         # fallback if the dashboard alert email is empty
NOTIFY_WEBHOOK_SECRET=                               # any long random string; the same value goes in the Supabase webhook header
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
